{
  config,
  lib,
  pkgs,
  pkgs-hyprland,
  pkgs-unstable,
  ...
}: let
  cfg = config.alex-desktop.hyprland;

  # Built against the same pinned Hyprland the system runs (see flake.nix).
  scrolloverview = pkgs-hyprland.callPackage ./scrolloverview.nix {};
  # Our own small plugin: niri's empty workspaces at both ends, kept ready.
  edgeworkspaces = pkgs-hyprland.callPackage ./edgeworkspaces.nix {};
  # Liquid Glass style blur and refraction (hyprnux/hyprglass)
  hyprglass = pkgs-hyprland.callPackage ./hyprglass.nix {};

  # For the bar: the active workspace's position on this bar's monitor,
  # counted from the top like niri (workspace ids like 1002 mean nothing).
  # Prints waybar JSON now and again on every workspace/monitor change.
  hypr-workspace-index = pkgs.writeShellScriptBin "hypr-workspace-index" ''
    export PATH=${lib.makeBinPath [pkgs.jq pkgs.socat pkgs.coreutils]}:$PATH
    output="''${WAYBAR_OUTPUT_NAME:-}"
    show() {
      mon="$output"
      [ -n "$mon" ] || mon=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')
      active=$(hyprctl -j monitors | jq --arg m "$mon" '.[] | select(.name == $m) | .activeWorkspace.id')
      [ -n "$active" ] || return
      hyprctl -j workspaces | jq -c --arg m "$mon" --argjson a "$active" '
        [.[] | select(.monitor == $m and .id > 0) | .id] | sort as $ids
        | (($ids | index($a)) // 0) + 1 as $n
        | {text: "\($n)", tooltip: "Workspace \($n) of \($ids | length)"}'
    }
    show
    socat -U - "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" |
      while read -r line; do
        case "$line" in
          workspace*|focusedmon*|createworkspace*|destroyworkspace*|moveworkspace*|renameworkspace*|monitor*) show ;;
        esac
      done
  '';
in {
  options.alex-desktop.hyprland = {
    enable = lib.mkEnableOption "Hyprland configuration";
    scrolloverview.enable =
      lib.mkEnableOption "the ScrollOverview workspace overview plugin"
      // {default = true;};
  };

  config = lib.mkIf cfg.enable {
    # Hyprland itself is installed by the system config (programs.hyprland).
    # Hyprland reads ~/.config/hypr/hyprland.lua and reloads it on change.
    home.file.".config/hypr" = {
      source = ./dotfiles;
      recursive = true;
    };

    # hyprland.lua loads the plugin from the path in this file when it exists.
    home.file.".config/hypr/scrolloverview-plugin.lua" = lib.mkIf cfg.scrolloverview.enable {
      text = ''
        -- Generated by home-manager (alex-desktop.hyprland.scrolloverview).
        return "${scrolloverview}/lib/libscrolloverview.so"
      '';
    };

    # pyprland: drop-down scratchpads (started from hyprland.lua).
    # From unstable: 3.4.6+ is needed for Hyprland's Lua IPC.
    xdg.configFile."pypr/config.toml".text = ''
      [pyprland]
      plugins = ["scratchpads"]

      # Mod+` : drop-down terminal
      [scratchpads.term]
      animation = "fromTop"
      command = "wezterm start --always-new-process --class dropterm"
      class = "dropterm"
      size = "75% 60%"
      max_size = "1920px 100%"
      margin = 50
      unfocus = "hide"

      # Mod+Shift+M : music player, slides in from the right
      # (GNOME Music is single-instance, so it's matched by class, not PID)
      [scratchpads.music]
      animation = "fromRight"
      command = "gnome-music"
      class = "org.gnome.Music"
      process_tracking = false
      size = "40% 85%"
      margin = 50
      unfocus = "hide"
    '';

    # hyprland.lua loads this plugin from the path in this file
    home.file.".config/hypr/edgeworkspaces-plugin.lua".text = ''
      -- Generated by home-manager (alex-desktop.hyprland).
      return "${edgeworkspaces}/lib/libedgeworkspaces.so"
    '';

    home.file.".config/hypr/hyprglass-plugin.lua".text = ''
      -- Generated by home-manager (alex-desktop.hyprland).
      return "${hyprglass}/lib/libhyprglass.so"
    '';

    # ---- Frutiger Aero look (Hyprland only; niri keeps its own) ----

    # Launcher: hyprland.lua starts fuzzel with this config instead of the
    # default fuzzel.ini. Frosted white glass (Hyprland blurs behind it).
    xdg.configFile."fuzzel/aero.ini".text = ''
      [main]
      terminal=wezterm start --always-new-process --
      font=Open Sans:size=13
      prompt="  "
      width=42
      lines=10
      horizontal-pad=24
      vertical-pad=18
      inner-pad=10
      line-height=24

      [colors]
      background=e8f6ffcc
      text=0b2a45ff
      prompt=1a7fc4ff
      input=0b2a45ff
      placeholder=5a7f9cff
      match=0a84d6ff
      selection=4fc3f7d9
      selection-text=ffffffff
      selection-match=eafff6ff
      border=ffffffe6

      [border]
      width=2
      radius=18
    '';

    # Notifications: an "aero" mode that hyprland.lua switches on while
    # Hyprland runs (mako is shared with niri, which keeps the default look).
    services.mako.settings."mode=aero" = {
      font = "Open Sans 11";
      background-color = "#e8f6ffd9";
      text-color = "#0b2a45";
      border-color = "#ffffffe6";
      border-size = 2;
      border-radius = 16;
      progress-color = "over #4fc3f7aa";
      padding = "12,16";
      margin = "12";
    };

    # Open Sans: a humanist sans close to the Aero-era Segoe UI / Frutiger look
    fonts.fontconfig.enable = true;

    home.packages = [
      hypr-workspace-index
      pkgs.open-sans
      pkgs.bibata-cursors # Bibata-Modern-Ice, the Aero-style cursor
      pkgs-unstable.pyprland
      pkgs.playerctl
      pkgs.grim # screenshots
      pkgs.slurp # region selection for screenshots
      pkgs.wl-clipboard
      pkgs.jq # focused-window screenshot (Alt+Print)
    ];
  };
}
