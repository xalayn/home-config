{
  config,
  lib,
  pkgs,
  pkgs-hyprland,
  pkgs-unstable,
  ...
}: let
  cfg = config.alex-desktop.hyprland;

  # Built against the same pinned Hyprland the system runs (see flake.nix).
  scrolloverview = pkgs-hyprland.callPackage ./scrolloverview.nix {};
  # Our own small plugin: niri's empty workspaces at both ends, kept ready.
  edgeworkspaces = pkgs-hyprland.callPackage ./edgeworkspaces.nix {};
in {
  options.alex-desktop.hyprland = {
    enable = lib.mkEnableOption "Hyprland configuration";
    scrolloverview.enable =
      lib.mkEnableOption "the ScrollOverview workspace overview plugin"
      // {default = true;};
  };

  config = lib.mkIf cfg.enable {
    # Hyprland itself is installed by the system config (programs.hyprland).
    # Hyprland reads ~/.config/hypr/hyprland.lua and reloads it on change.
    home.file.".config/hypr" = {
      source = ./dotfiles;
      recursive = true;
    };

    # hyprland.lua loads the plugin from the path in this file when it exists.
    home.file.".config/hypr/scrolloverview-plugin.lua" = lib.mkIf cfg.scrolloverview.enable {
      text = ''
        -- Generated by home-manager (alex-desktop.hyprland.scrolloverview).
        return "${scrolloverview}/lib/libscrolloverview.so"
      '';
    };

    # pyprland: drop-down scratchpads (started from hyprland.lua).
    # From unstable: 3.4.6+ is needed for Hyprland's Lua IPC.
    xdg.configFile."pypr/config.toml".text = ''
      [pyprland]
      plugins = ["scratchpads"]

      # Mod+` : drop-down terminal
      [scratchpads.term]
      animation = "fromTop"
      command = "wezterm start --always-new-process --class dropterm"
      class = "dropterm"
      size = "75% 60%"
      max_size = "1920px 100%"
      margin = 50
      unfocus = "hide"

      # Mod+Shift+M : music player, slides in from the right
      # (GNOME Music is single-instance, so it's matched by class, not PID)
      [scratchpads.music]
      animation = "fromRight"
      command = "gnome-music"
      class = "org.gnome.Music"
      process_tracking = false
      size = "40% 85%"
      margin = 50
      unfocus = "hide"
    '';

    # hyprland.lua loads this plugin from the path in this file
    home.file.".config/hypr/edgeworkspaces-plugin.lua".text = ''
      -- Generated by home-manager (alex-desktop.hyprland).
      return "${edgeworkspaces}/lib/libedgeworkspaces.so"
    '';

    home.packages = [
      pkgs-unstable.pyprland
      pkgs.playerctl
      pkgs.grim # screenshots
      pkgs.slurp # region selection for screenshots
      pkgs.wl-clipboard
      pkgs.jq # focused-window screenshot (Alt+Print)
    ];
  };
}
