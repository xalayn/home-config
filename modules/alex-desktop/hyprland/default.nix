{
  config,
  lib,
  pkgs,
  pkgs-hyprland,
  ...
}: let
  cfg = config.alex-desktop.hyprland;

  # Built against the same pinned Hyprland the system runs (see flake.nix).
  phantomat = pkgs-hyprland.callPackage ./phantomat.nix {};
in {
  options.alex-desktop.hyprland = {
    enable = lib.mkEnableOption "Hyprland configuration";
    phantomat.enable =
      lib.mkEnableOption "the Phantomat infinite-canvas plugin"
      // {default = true;};
  };

  config = lib.mkIf cfg.enable {
    # Hyprland itself is installed by the system config (programs.hyprland).
    # Hyprland reads ~/.config/hypr/hyprland.lua and reloads it on change.
    # Linked file by file (not the whole directory) so Phantomat's live tuner
    # can still write spatialoverview-tuning.lua next to them.
    home.file.".config/hypr" = {
      source = ./dotfiles;
      recursive = true;
    };

    # hyprland.lua loads the plugin from the path in this file when it exists.
    home.file.".config/hypr/phantomat-plugin.lua" = lib.mkIf cfg.phantomat.enable {
      text = ''
        -- Generated by home-manager (alex-desktop.hyprland.phantomat).
        return "${phantomat}/lib/libspatialoverview.so"
      '';
    };

    home.packages = [
      pkgs.playerctl
      pkgs.grim # screenshots
      pkgs.slurp # region selection for screenshots
      pkgs.wl-clipboard
    ];
  };
}
