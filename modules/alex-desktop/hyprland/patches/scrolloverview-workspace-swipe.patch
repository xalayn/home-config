+
+void CScrollOverview::onWorkspaceSwipe(double delta) {
+    if (images.empty() || viewportCurrentWorkspace >= images.size())
+        return;
+    trackpadSwipeWorkspace(delta);
+}
+
+// Pushing past the first or last workspace (like niri) opens a new empty
+// workspace there, unless the end workspace is already empty.
+void CScrollOverview::createWorkspacePastEnd(double overscroll) {
+    // roughly a fifth of a finger swipe across the trackpad
+    constexpr double THRESHOLD = 60.0;
+
+    const auto MONITOR = pMonitor.lock();
+    if (!MONITOR || images.empty() || std::abs(overscroll) < THRESHOLD)
+        return;
+
+    const bool   PAST_TOP = overscroll < 0;
+    const size_t EDGE     = PAST_TOP ? 0 : images.size() - 1;
+    if (viewportCurrentWorkspace != EDGE || !images[EDGE] || !images[EDGE]->pWorkspace)
+        return;
+
+    const auto EDGEWS = images[EDGE]->pWorkspace;
+    if (EDGEWS->getWindowCount() == 0 || MONITOR->m_activeWorkspace != EDGEWS)
+        return;
+
+    const auto TARGET = State::Workspace::resolver()->getWorkspaceTargetFromString(PAST_TOP ? "r-1" : "r+1", MONITOR);
+    if (!TARGET.valid() || State::Workspace::state()->find(TARGET))
+        return;
+
+    const auto NEWWS = State::Workspace::state()->create(TARGET, MONITOR);
+    if (!NEWWS)
+        return;
+
+    changeOverviewWorkspace(MONITOR, NEWWS);
+    damage();
+}
