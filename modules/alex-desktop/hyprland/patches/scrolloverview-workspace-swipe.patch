+
+#include <hyprland/src/managers/input/trackpad/gestures/WorkspaceSwipeGesture.hpp>
+#include <hyprland/src/config/ConfigValue.hpp>
+
+COverviewWorkspaceGesture::COverviewWorkspaceGesture() : m_fallback(makeUnique<CWorkspaceSwipeGesture>()) {}
+
+void COverviewWorkspaceGesture::begin(const ITrackpadGesture::STrackpadGestureBegin& e) {
+    ITrackpadGesture::begin(e);
+    m_overview.reset();
+
+    const auto MONITOR  = Desktop::focusState()->monitor();
+    const auto OVERVIEW = MONITOR ? scrollOverviewForMonitor(MONITOR) : nullptr;
+    if (OVERVIEW && !OVERVIEW->isClosing()) {
+        m_overview = OVERVIEW;
+        return;
+    }
+
+    m_fallback->begin(e);
+}
+
+void COverviewWorkspaceGesture::update(const ITrackpadGesture::STrackpadGestureUpdate& e) {
+    if (m_overview.expired()) {
+        m_fallback->update(e);
+        return;
+    }
+
+    const auto OVERVIEW = m_overview.lock();
+    if (!OVERVIEW || OVERVIEW->isClosing())
+        return;
+
+    // same sign convention as Hyprland's workspace swipe
+    static auto PSWIPEINVR = CConfigValue<::Config::INTEGER>("gestures:workspace_swipe_invert");
+    const float DELTA      = distance(e);
+    const float D          = *PSWIPEINVR ? -DELTA : DELTA;
+    if (D != 0.F)
+        OVERVIEW->onWorkspaceSwipe(D);
+}
+
+void COverviewWorkspaceGesture::end(const ITrackpadGesture::STrackpadGestureEnd& e) {
+    if (m_overview.expired()) {
+        m_fallback->end(e);
+        return;
+    }
+
+    const auto OVERVIEW = m_overview.lock();
+    m_overview.reset();
+    if (OVERVIEW && std::ranges::find(scrollOverviews(), OVERVIEW) != scrollOverviews().end())
+        OVERVIEW->onWorkspaceSwipe(0.0);
+}
+
+bool COverviewWorkspaceGesture::isDirectionSensitive() {
+    return true;
+}
